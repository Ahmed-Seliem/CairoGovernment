@{
    var title = ViewData["Title"] as string ?? "محافظة القاهرة";
    var currentPage = ViewData["CurrentPage"] as string ?? string.Empty;
    var navigation = new[]
    {
        new { Key = "home", Url = "/", Label = "الرئيسية" },
        new { Key = "ads", Url = "/ads", Label = "الإعلانات" },
        new { Key = "digital-transformation", Url = "/digital-transformation", Label = "التحول الرقمي" },
        new { Key = "governor", Url = "/governor", Label = "المحافظ" },
        new { Key = "hayah-karima", Url = "/hayah-karima", Label = "حياة كريمة" },
        new { Key = "org-chart", Url = "/org-chart", Label = "الهيكل التنظيمي" }
    };
    var footerLinks = new[]
    {
        new { Url = "/", Label = "الرئيسية", Icon = "bi-house-door" },
        new { Url = "/ads", Label = "الإعلانات", Icon = "bi-megaphone" },
        new { Url = "/digital-transformation", Label = "التحول الرقمي", Icon = "bi-cpu" },
        new { Url = "/governor", Label = "المحافظ", Icon = "bi-person-badge" },
        new { Url = "/hayah-karima", Label = "حياة كريمة", Icon = "bi-heart" },
        new { Url = "/org-chart", Label = "الهيكل التنظيمي", Icon = "bi-diagram-3" }
    };
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - محافظة القاهرة</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
        }

        .cairo-site-shell {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .cairo-site-header {
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(12px);
            background: rgba(255, 255, 255, 0.9);
            border-bottom: 1px solid rgba(148, 163, 184, 0.18);
        }

        .cairo-site-header-inner,
        .cairo-site-footer-inner {
            width: min(1520px, calc(100% - 32px));
            margin: 0 auto;
        }

        .cairo-site-header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            min-height: 76px;
            padding: 14px 0;
        }

        .cairo-site-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #111827;
            text-decoration: none;
        }

        .cairo-site-brand-mark {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, #ef4444, #b91c1c);
            color: #fff;
            box-shadow: 0 10px 24px rgba(185, 28, 28, 0.22);
            font-size: 22px;
        }

        .cairo-site-brand-text {
            display: flex;
            flex-direction: column;
            gap: 2px;
            font-family: "Cairo", Tahoma, Arial, sans-serif;
        }

        .cairo-site-brand-title {
            font-size: 18px;
            font-weight: 900;
            line-height: 1.1;
        }

        .cairo-site-brand-subtitle {
            font-size: 12px;
            color: #6b7280;
            font-weight: 600;
        }

        .cairo-site-nav {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
            font-family: "Cairo", Tahoma, Arial, sans-serif;
        }

        .cairo-site-nav-link {
            color: #374151;
            text-decoration: none;
            padding: 10px 16px;
            border-radius: 999px;
            font-size: 14px;
            font-weight: 700;
            transition: background-color .18s ease, color .18s ease, transform .18s ease;
        }

        .cairo-site-nav-link:hover {
            background: rgba(239, 68, 68, 0.08);
            color: #b91c1c;
            transform: translateY(-1px);
        }

        .cairo-site-nav-link.is-active {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: #fff;
            box-shadow: 0 10px 24px rgba(220, 38, 38, 0.2);
        }

        .cairo-site-main {
            flex: 1;
        }

        .cairo-site-footer {
            margin-top: 24px;
            padding: 0 0 28px;
        }

        .cairo-site-footer-card {
            background:
                radial-gradient(circle at top right, rgba(239, 68, 68, 0.10), transparent 26%),
                linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(248, 250, 252, 0.96));
            border: 1px solid rgba(148, 163, 184, 0.16);
            border-radius: 28px;
            box-shadow: 0 20px 48px rgba(15, 23, 42, 0.08);
            padding: 28px;
            font-family: "Cairo", Tahoma, Arial, sans-serif;
        }

        .cairo-site-footer-grid {
            display: grid;
            grid-template-columns: 1.15fr 1fr 1fr;
            gap: 22px;
            align-items: start;
        }

        .cairo-site-footer-title {
            margin: 0 0 6px;
            font-size: 20px;
            font-weight: 900;
            color: #111827;
        }

        .cairo-site-footer-copy,
        .cairo-site-footer-note {
            margin: 0;
            color: #6b7280;
            font-size: 13px;
            line-height: 1.8;
            font-weight: 600;
        }

        .cairo-site-footer-heading {
            margin: 0 0 12px;
            font-size: 15px;
            font-weight: 800;
            color: #111827;
        }

        .cairo-site-footer-links {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .cairo-site-footer-contact {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .cairo-site-footer-socials {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 10px;
            flex-wrap: wrap;
        }

        .cairo-site-footer-link,
        .cairo-site-footer-contact-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 11px 14px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.88);
            color: #374151;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            border: 1px solid rgba(226, 232, 240, 0.9);
            transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
        }

        .cairo-site-footer-link:hover,
        .cairo-site-footer-contact-item:hover,
        .cairo-site-footer-social:hover {
            transform: translateY(-1px);
            border-color: rgba(239, 68, 68, 0.32);
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.07);
        }

        .cairo-site-footer-link i,
        .cairo-site-footer-contact-item i {
            color: #dc2626;
            font-size: 15px;
        }

        .cairo-site-footer-social {
            width: 44px;
            height: 44px;
            display: inline-grid;
            place-items: center;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.88);
            color: #1f2937;
            text-decoration: none;
            border: 1px solid rgba(226, 232, 240, 0.9);
            font-size: 18px;
            transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease, color .18s ease;
        }

        .cairo-site-footer-social:hover {
            color: #dc2626;
        }

        .cairo-site-footer-map {
            margin-top: 14px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: 16px;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            font-weight: 800;
            box-shadow: 0 14px 28px rgba(220, 38, 38, 0.2);
        }

        @@media (max-width: 980px) {
            .cairo-site-header-inner {
                flex-direction: column;
                align-items: stretch;
            }

            .cairo-site-nav {
                justify-content: center;
            }

            .cairo-site-footer-grid {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .cairo-site-footer-links {
                grid-template-columns: 1fr 1fr;
            }

            .cairo-site-footer-socials {
                justify-content: center;
            }

            .cairo-site-footer-map {
                justify-content: center;
            }

            .cairo-site-footer-contact {
                align-items: stretch;
            }

            .cairo-site-footer-link,
            .cairo-site-footer-contact-item {
                justify-content: center;
            }
        }

        @@media (max-width: 640px) {
            .cairo-site-header-inner,
            .cairo-site-footer-inner {
                width: min(1520px, calc(100% - 20px));
            }

            .cairo-site-nav {
                justify-content: center;
            }

            .cairo-site-nav {
                gap: 8px;
            }

            .cairo-site-nav-link {
                width: 100%;
                text-align: center;
            }

            .cairo-site-footer-links {
                grid-template-columns: 1fr;
            }
        }
    </style>
    @RenderSection("Head", required: false)
</head>
<body>
    <div class="cairo-site-shell">
        <header class="cairo-site-header">
            <div class="cairo-site-header-inner">
                <a class="cairo-site-brand" href="/">
                    <span class="cairo-site-brand-mark"><i class="bi bi-buildings"></i></span>
                    <span class="cairo-site-brand-text">
                        <span class="cairo-site-brand-title">محافظة القاهرة</span>
                        <span class="cairo-site-brand-subtitle">بوابة الصفحات التعريفية</span>
                    </span>
                </a>

                <nav class="cairo-site-nav" aria-label="التنقل الرئيسي">
                    @foreach (var item in navigation)
                    {
                        var isActive = string.Equals(currentPage, item.Key, StringComparison.OrdinalIgnoreCase);
                        <a class="cairo-site-nav-link @(isActive ? "is-active" : null)" href="@item.Url">@item.Label</a>
                    }
                </nav>
            </div>
        </header>

        <main class="cairo-site-main">
            @RenderBody()
        </main>

        <footer class="cairo-site-footer">
            <div class="cairo-site-footer-inner">
                <div class="cairo-site-footer-card">
                    <div class="cairo-site-footer-grid">
                        <div>
                            <p class="cairo-site-footer-title">محافظة القاهرة</p>
                            <p class="cairo-site-footer-copy">بوابة مختصرة لاستعراض الخدمات والمبادرات والصفحات التعريفية الخاصة بمحافظة القاهرة.</p>
                            <a class="cairo-site-footer-map" href="https://www.google.com/maps/search/?api=1&amp;query=Cairo+Governorate" target="_blank" rel="noreferrer">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>عرض المحافظة على الخريطة</span>
                            </a>
                        </div>

                        <div>
                            <p class="cairo-site-footer-heading">روابط سريعة</p>
                            <div class="cairo-site-footer-links">
                                @foreach (var item in footerLinks)
                                {
                                    <a class="cairo-site-footer-link" href="@item.Url">
                                        <i class="bi @item.Icon"></i>
                                        <span>@item.Label</span>
                                    </a>
                                }
                            </div>
                        </div>

                        <div>
                            <p class="cairo-site-footer-heading">تواصل ومتابعة</p>
                            <div class="cairo-site-footer-contact">
                                <a class="cairo-site-footer-contact-item" href="/governor">
                                    <i class="bi bi-person-lines-fill"></i>
                                    <span>مكتب المحافظ والقيادة التنفيذية</span>
                                </a>
                                <a class="cairo-site-footer-contact-item" href="/digital-transformation">
                                    <i class="bi bi-phone"></i>
                                    <span>الخدمات الرقمية والمبادرات</span>
                                </a>
                                <div class="cairo-site-footer-socials">
                                    <a class="cairo-site-footer-social" href="https://facebook.com" target="_blank" rel="noreferrer" aria-label="Facebook">
                                        <i class="bi bi-facebook"></i>
                                    </a>
                                    <a class="cairo-site-footer-social" href="https://youtube.com" target="_blank" rel="noreferrer" aria-label="YouTube">
                                        <i class="bi bi-youtube"></i>
                                    </a>
                                    <a class="cairo-site-footer-social" href="https://instagram.com" target="_blank" rel="noreferrer" aria-label="Instagram">
                                        <i class="bi bi-instagram"></i>
                                    </a>
                                    <a class="cairo-site-footer-social" href="https://x.com" target="_blank" rel="noreferrer" aria-label="X">
                                        <i class="bi bi-twitter-x"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
